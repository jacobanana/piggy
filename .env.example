# Piggy configuration.
# Every value has a development default baked into src/core/config.py —
# only override what you need. Copy to .env; nothing here is required to
# run `make dev` or `docker compose up`.

# development | production | test
#ENVIRONMENT=development

# --- database ---------------------------------------------------------------
#DATABASE_URL=postgresql://piggy_user:piggy_dev_password@localhost:5432/piggy
#POSTGRES_DB=piggy
#POSTGRES_USER=piggy_user
#POSTGRES_PASSWORD=piggy_dev_password
#POSTGRES_PORT=5432

# --- auth ---------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
#JWT_SECRET_KEY=
#ACCESS_TOKEN_EXPIRE_MINUTES=1440
#REFRESH_TOKEN_EXPIRE_DAYS=30
# Dev-only password-less login (the picker on the login page). The app
# refuses to boot with this on in production.
#DEV_AUTH_ENABLED=true

# --- email (sign-in codes) ----------------------------------------------------
# Both empty -> codes are printed to the server log instead of emailed,
# and `manage login-code --email you@example.com` reads them back.
# Check a configured relay with `manage test-email --to you@example.com`.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
# NOT the mailbox's own password on Infomaniak, Gmail or Fastmail: SMTP wants
# an application password (Infomaniak: Manager > Mail > connected devices /
# "appareil connecté"). A password that signs into webmail is still refused here.
#SMTP_PASSWORD=
#EMAIL_SENDER=piggy@yourdomain.tld
# Seconds before a silent relay is given up on.
#SMTP_TIMEOUT=15
# Prints the SMTP conversation, which includes the password base64-encoded.
#SMTP_DEBUG=false

# --- logging ------------------------------------------------------------------
#LOG_LEVEL=INFO

# --- frontend -----------------------------------------------------------------
# Origin allowed by CORS; also where auth emails link back to.
#FRONTEND_URL=http://localhost:5173
#FRONTEND_DIST_DIR=frontend/dist

# --- docker compose ports -------------------------------------------------------
#BACKEND_PORT=8000
#ADMINER_PORT=8080
